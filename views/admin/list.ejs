<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> · 拾光筆記後台</title>
  <link rel="stylesheet" href="/admin/assets/admin.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="admin">
  <header class="admin-bar">
    <div class="admin-bar__left">
      <span class="admin-brand"><%- include('partials/icon', { name: 'seal' }) %>拾光筆記 · 後台</span>
      <span class="admin-hint">仅本地可用，线上不暴露</span>
    </div>
    <div class="admin-bar__right">
      <span class="admin-git" id="git-status">检查仓库状态…</span>
      <%# 用按钮而非链接：应用窗口没有标签页，站内跳转会把后台顶掉，
          所以交给服务端用系统默认浏览器打开 %>
      <button type="button" class="btn btn--ghost" id="btn-view-site"><%- include('partials/icon', { name: 'external' }) %>预览站点</button>
      <button type="button" class="btn btn--gold" id="btn-publish-all"><%- include('partials/icon', { name: 'upload' }) %>发布到线上</button>
      <a class="btn btn--primary" href="/admin/new"><%- include('partials/icon', { name: 'plus' }) %>写新文章</a>
      <%# 启动时命令行窗口被藏起来了，这里是唯一的退出出口 %>
      <span class="admin-bar__sep" aria-hidden="true"></span>
      <button type="button" class="btn btn--ghost btn--quiet" id="btn-quit"><%- include('partials/icon', { name: 'power' }) %>退出后台</button>
    </div>
  </header>

  <main class="admin-main">
    <div class="admin-stats">
      <span><b><%= stats.postCount %></b> 篇文章</span>
      <span><b><%= stats.tagCount %></b> 个标签</span>
      <span><b><%= stats.categoryCount %></b> 个分类</span>
      <span><b><%= stats.totalWords %></b> 字</span>
    </div>

    <% if (posts.length) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>标题</th>
          <th>日期</th>
          <th>分类</th>
          <th>标签</th>
          <th class="num">字数</th>
          <th class="col-actions">操作</th>
        </tr>
      </thead>
      <tbody>
        <% posts.forEach(function (post) { %>
        <tr>
          <td>
            <a class="post-title" href="/admin/edit/<%= post.slug %>"><%= post.title %></a>
            <% if (post.draft) { %><span class="badge">草稿</span><% } %>
          </td>
          <td class="dim"><%= post.date %></td>
          <td class="dim"><%= post.category %></td>
          <td class="dim"><%= post.tags.join(' · ') %></td>
          <td class="dim num"><%= post.words %></td>
          <td class="col-actions">
            <a class="btn btn--tiny" href="/admin/edit/<%= post.slug %>"><%- include('partials/icon', { name: 'pencil' }) %>编辑</a>
            <button type="button" class="btn btn--tiny btn--danger"
                    data-delete="<%= post.slug %>"
                    data-title="<%= post.title %>"><%- include('partials/icon', { name: 'trash' }) %>删除</button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
      <p class="admin-empty">还没有文章。<a href="/admin/new">写第一篇</a>。</p>
    <% } %>
  </main>

  <%- include('partials/farewell') %>

  <div class="toast" id="toast" hidden></div>
  <script src="/admin/assets/admin.js"></script>
</body>
</html>
