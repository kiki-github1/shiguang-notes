<header class="site-header" id="siteHeader">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="<%= site.title %> 首頁">
      <span class="seal seal-single" aria-hidden="true">拾</span>
      <span class="brand-text">
        <strong><%= site.title %></strong>
        <em><%= site.subtitle %></em>
      </span>
    </a>

    <nav class="nav" id="primaryNav" aria-label="主導航">
      <% nav.forEach(function (item) { %>
        <a class="nav-link<%= activePath === item.path ? ' is-active' : '' %>" href="<%= item.path %>"
           <%= activePath === item.path ? 'aria-current="page"' : '' %>><%= item.name %></a>
      <% }); %>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="searchToggle" type="button" aria-label="檢索文章" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <button class="icon-btn" id="themeToggle" type="button" aria-label="切換明暗">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.4v2M12 19.6v2M2.4 12h2M19.6 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <button class="icon-btn nav-toggle" id="navToggle" type="button" aria-label="展開導航" aria-expanded="false" aria-controls="primaryNav">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="search-panel" id="searchPanel" hidden>
    <div class="shell">
      <form class="search-form" action="/search" method="get" role="search">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <input type="search" name="q" id="searchInput" placeholder="檢索標題、標籤或正文…" autocomplete="off" aria-label="檢索關鍵詞">
        <kbd>Esc</kbd>
      </form>
    </div>
  </div>
</header>
