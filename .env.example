# ============================================================
# 拾光筆記 · 环境变量模板
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会被提交。
#   cp .env.example .env
# 项目本身不依赖 dotenv —— 请用平台的变量面板，或
# `export $(grep -v '^#' .env | xargs)` 之类的方式注入。
# ============================================================

# 运行环境。production 会：隐藏 draft 文章、开启 HSTS、监听 0.0.0.0
NODE_ENV=production

# 服务端口。云平台通常自动注入 PORT，本地留空即用 3000
PORT=3000

# 监听地址。一般不用手动设置：
#   开发环境默认 127.0.0.1（局域网内其他机器访问不到，更安全）
#   生产环境默认 0.0.0.0（容器必须如此，否则平台健康检查连不进来）
# HOST=0.0.0.0

# 站点对外地址，用于 RSS / sitemap / canonical / 社交分享的绝对链接。
# 必须带 http(s):// 前缀，结尾不要加斜杠。留空则回退到 http://localhost:3000
SITE_URL=https://your-domain.example

# 是否信任反向代理。只有确实部署在 Nginx / Caddy / 云平台负载均衡之后才设为 true，
# 让限流能拿到真实客户端 IP。无条件开启会让攻击者用 X-Forwarded-For
# 伪造来源 IP，从而绕过按 IP 的限流。
TRUST_PROXY=false
